<view class="container">
  <view class="header">
    <text class="title game-font">恋爱飞行棋</text>
    <text class="subtitle">ROMANTIC GAME V3.0</text>
  </view>
  
  <view class="mode-list">
    <view 
      wx:for="{{modes}}" 
      wx:key="key"
      class="mode-item"
      bindtap="initGame"
      data-key="{{item.key}}"
    >
      <view class="mode-content">
        <text class="mode-icon">{{item.icon}}</text>
        <text class="mode-name">{{item.name}}</text>
      </view>
      <text class="arrow">❯</text>
    </view>
  </view>
</view>
