@import url('https://fonts.googleapis.com/css2?family=ZCOOL+KuaiLe&display=swap');

page {
  font-family: 'PingFang SC', -apple-system, sans-serif;
  background: #fff1f2;
  min-height: 100vh;
}

.game-font {
  font-family: 'ZCOOL KuaiLe', cursive;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.title {
  font-size: 100rpx;
  color: #f43f5e;
  font-style: italic;
  text-shadow: 0 4px 8px rgba(244, 63, 94, 0.3);
  display: block;
}

.subtitle {
  color: #fda4af;
  font-size: 24rpx;
  margin-top: 16rpx;
  letter-spacing: 4rpx;
  font-weight: bold;
  display: block;
}

.mode-list {
  width: 100%;
  padding: 0 32rpx;
}

.mode-item {
  background: white;
  padding: 40rpx 64rpx;
  border-radius: 80rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8px 16px rgba(244, 63, 94, 0.1);
  border-bottom: 8rpx solid #ffe4e6;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s;
}

.mode-item:active {
  transform: translateY(4rpx);
  border-bottom-width: 0;
}

.mode-content {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.mode-icon {
  font-size: 60rpx;
}

.mode-name {
  font-weight: bold;
  color: #e11d48;
  font-size: 36rpx;
}

.arrow {
  color: #fecdd3;
  font-size: 32rpx;
}
